{
  "version": "1.1.0",
  "source": "Full Android Native Security Suite",
  "patterns": {
    "network": [
      {
        "id": "AND-NET-001",
        "pattern": "http://",
        "severity": "medium",
        "title": "Cleartext HTTP URL",
        "description": "URL sin cifrar detectada en el código.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Usa HTTPS para todas las comunicaciones."
      },
      {
        "id": "AND-NET-002",
        "pattern": "setHostnameVerifier\\(.*?ALLOW_ALL",
        "severity": "critical",
        "title": "Hostname Verification Disabled",
        "description": "Verificación de hostname deshabilitada permite MITM.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Nunca deshabilites la verificación de hostname."
      },
      {
        "id": "AND-NET-003",
        "pattern": "Proxy\\.NO_PROXY",
        "severity": "info",
        "title": "Explicit Proxy Bypass",
        "description": "La app ignora la configuración de proxy del sistema.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Permite que el sistema maneje el proxy."
      },
      {
        "id": "AND-NET-004",
        "pattern": "ALLOW_ALL_HOSTNAME_VERIFIER",
        "severity": "critical",
        "title": "Allow All Hostname Verifier",
        "description": "Acepta cualquier host sin importar el certificado.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Usa STRICT_HOSTNAME_VERIFIER."
      },
      {
        "id": "AND-NET-005",
        "pattern": "TrustAllCertificates|TrustAllSSL|DisableSSL",
        "severity": "critical",
        "title": "SSL/TLS Validation Disabled",
        "description": "Validación SSL completamente deshabilitada.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Nunca deshabilites la validación SSL."
      },
      {
        "id": "AND-NET-006",
        "pattern": "X509TrustManager.*checkServerTrusted.*\\{\\s*\\}",
        "severity": "critical",
        "title": "Empty TrustManager",
        "description": "Implementación que confía en cualquier certificado.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Implementa validación real."
      },
      {
        "id": "AND-NET-007",
        "pattern": "checkServerTrusted\\(\\s*X509Certificate\\[\\]\\s*chain",
        "severity": "info",
        "title": "Custom SSL Validation",
        "description": "Lógica personalizada para validar certificados.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Audita manualmente la rigurosidad."
      },
      {
        "id": "AND-NET-008",
        "pattern": "addHeader\\(\\s*['\"]Authorization['\"]",
        "severity": "info",
        "title": "Auth Header Detected",
        "description": "Inyección de credenciales en cabeceras.",
        "owaspCategory": "M4: Insufficient Authentication",
        "recommendation": "Verifica que no viajen sobre HTTP."
      }
    ],
    "crypto": [
      {
        "id": "AND-CRY-001",
        "pattern": "Cipher\\.getInstance\\(\\s*['\"]AES/ECB/",
        "severity": "critical",
        "title": "Insecure AES Mode (ECB)",
        "description": "ECB no usa IV, lo que lo hace determinista.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Cambia a AES/GCM/NoPadding."
      },
      {
        "id": "AND-CRY-002",
        "pattern": "MessageDigest\\.getInstance\\(\\s*['\"]MD5['\"]",
        "severity": "high",
        "title": "Weak Hash Algorithm (MD5)",
        "description": "MD5 es propenso a colisiones.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Utiliza SHA-256."
      },
      {
        "id": "AND-CRY-003",
        "pattern": "MessageDigest\\.getInstance\\(\\s*['\"]SHA-1['\"]",
        "severity": "high",
        "title": "Weak Hash Algorithm (SHA-1)",
        "description": "SHA-1 tiene debilidades criptográficas.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Migra a SHA-256."
      },
      {
        "id": "AND-CRY-004",
        "pattern": "Cipher\\.getInstance\\(\\s*['\"]DES/",
        "severity": "critical",
        "title": "Weak Encryption (DES)",
        "description": "Llave de 56 bits vulnerable a fuerza bruta.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Usa AES-256."
      },
      {
        "id": "AND-CRY-005",
        "pattern": "new\\s+SecretKeySpec\\(\\s*.*\\.getBytes\\(\\)",
        "severity": "high",
        "title": "Hardcoded Key",
        "description": "Clave de cifrado escrita en el código.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Usa Android KeyStore."
      },
      {
        "id": "AND-CRY-006",
        "pattern": "SecureRandom\\.setSeed\\(",
        "severity": "critical",
        "title": "Static PRNG Seed",
        "description": "Reducción de entropía al forzar semilla.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Deja que el sistema inicialice la semilla."
      },
      {
        "id": "AND-CRY-007",
        "pattern": "PBEKeySpec\\(\\s*.*,\\s*.*,\\s*([0-9]{1,3})\\s*,",
        "severity": "medium",
        "title": "Low PBE Iterations",
        "description": "Pocas iteraciones facilitan fuerza bruta.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Usa al menos 10,000."
      },
      {
        "id": "AND-CRY-008",
        "pattern": "new\\s+IvParameterSpec\\(\\s*['\"].{1,16}['\"]",
        "severity": "high",
        "title": "Hardcoded IV",
        "description": "IV estático rompe la seguridad del cifrado.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Genera IV aleatorios."
      },
      {
        "id": "AND-CRY-009",
        "pattern": "RSA/NONE/NoPadding",
        "severity": "critical",
        "title": "RSA without Padding",
        "description": "RSA sin padding es vulnerable matemáticamente.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Usa OAEP con SHA-256."
      },
      {
        "id": "AND-CRY-010",
        "pattern": "DESede/",
        "severity": "high",
        "title": "Weak Encryption (TripleDES)",
        "description": "Algoritmo legado con tamaño de bloque pequeño.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Usa AES."
      },
      {
        "id": "AND-CRY-011",
        "pattern": "KeyPairGenerator.*initialize\\(\\s*(512|1024)",
        "severity": "high",
        "title": "Short RSA Key Size",
        "description": "Llaves RSA menores a 2048 bits son inseguras.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Usa 2048 o 4096 bits."
      },
      {
        "id": "AND-CRY-012",
        "pattern": "Blowfish",
        "severity": "high",
        "title": "Weak Algorithm Blowfish",
        "description": "Superado por AES en seguridad.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Sustituir por AES."
      },
      {
        "id": "AND-CRY-013",
        "pattern": "RC4|ARCFOUR",
        "severity": "critical",
        "title": "Weak Algorithm RC4",
        "description": "RC4 tiene múltiples vulnerabilidades conocidas.",
        "owaspCategory": "M5: Insufficient Cryptography",
        "recommendation": "Usa AES."
      }
    ],
    "storage": [
      {
        "id": "AND-STO-001",
        "pattern": "MODE_WORLD_READABLE",
        "severity": "critical",
        "title": "World Readable Storage",
        "description": "Archivos accesibles por cualquier app.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Usa MODE_PRIVATE."
      },
      {
        "id": "AND-STO-002",
        "pattern": "MODE_WORLD_WRITEABLE",
        "severity": "critical",
        "title": "World Writeable Storage",
        "description": "Archivos modificables por terceros.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Usa MODE_PRIVATE."
      },
      {
        "id": "AND-STO-003",
        "pattern": "getExternalStorageDirectory",
        "severity": "high",
        "title": "Insecure External Storage",
        "description": "Almacenamiento global sin sandbox.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Usa almacenamiento interno."
      },
      {
        "id": "AND-STO-004",
        "pattern": "SQLiteDatabase.*null",
        "severity": "medium",
        "title": "Unencrypted SQLite",
        "description": "BD local sin cifrado expuesta.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Implementa SQLCipher."
      },
      {
        "id": "AND-STO-005",
        "pattern": "openFileOutput\\(.*?\\d",
        "severity": "high",
        "title": "Insecure File Flags",
        "description": "Flags que exponen archivos al sistema.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Usa modo 0."
      },
      {
        "id": "AND-STO-006",
        "pattern": "createTempFile",
        "severity": "low",
        "title": "Insecure Temp File",
        "description": "Ficheros temporales expuestos.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Bórralos tras su uso."
      },
      {
        "id": "AND-STO-007",
        "pattern": "getExternalStoragePublicDirectory",
        "severity": "high",
        "title": "Public Storage Exposure",
        "description": "Uso de directorios públicos para datos de app.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Usa Scoped Storage."
      },
      {
        "id": "AND-STO-008",
        "pattern": "EncryptedSharedPreferences\\.create",
        "severity": "info",
        "title": "Encrypted Storage",
        "description": "Uso de almacenamiento cifrado Jetpack.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Gestiona MasterKey en KeyStore."
      },
      {
        "id": "AND-STO-009",
        "pattern": "Realm\\.getInstance",
        "severity": "info",
        "title": "Realm DB Usage",
        "description": "Uso de base de datos Realm.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Verifica encryptionKey."
      },
      {
        "id": "AND-STO-010",
        "pattern": "getCacheDir\\(\\)",
        "severity": "low",
        "title": "Cache Directory",
        "description": "Datos en caché no cifrados.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "No guardes datos sensibles en caché."
      },
      {
        "id": "AND-STO-011",
        "pattern": "getSharedPreferences.*MODE_PRIVATE",
        "severity": "info",
        "title": "SharedPreferences Usage",
        "description": "Uso de SharedPreferences sin cifrado.",
        "owaspCategory": "M2: Insecure Data Storage",
        "recommendation": "Usa EncryptedSharedPreferences para datos sensibles."
      }
    ],
    "pathtraversal": [
      {
        "id": "AND-PT-001",
        "pattern": "\\.\\./",
        "severity": "critical",
        "title": "Path Traversal Pattern",
        "description": "Patrón de traversal detectado en string literal.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Valida y sanitiza todas las rutas de archivo."
      },
      {
        "id": "AND-PT-002",
        "pattern": "new\\s+File\\(.*?\\+.*?\\)",
        "severity": "high",
        "title": "Dynamic File Path Construction",
        "description": "Construcción de rutas con concatenación puede permitir traversal.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Usa File.getCanonicalPath() y valida contra directorio base."
      },
      {
        "id": "AND-PT-003",
        "pattern": "openFileInput\\(.*?\\+",
        "severity": "high",
        "title": "Dynamic File Input",
        "description": "Apertura de archivo con nombre dinámico.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Valida el nombre de archivo contra whitelist."
      },
      {
        "id": "AND-PT-004",
        "pattern": "getCanonicalPath|getAbsolutePath",
        "severity": "info",
        "title": "Path Canonicalization",
        "description": "Uso de canonicalización de rutas detectado.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Verifica que se compare contra directorio permitido."
      },
      {
        "id": "AND-PT-005",
        "pattern": "FileProvider.*getUriForFile",
        "severity": "medium",
        "title": "FileProvider Usage",
        "description": "Exposición de archivos via FileProvider.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Verifica configuración de paths en file_paths.xml."
      },
      {
        "id": "AND-PT-006",
        "pattern": "Uri\\.parse.*file://",
        "severity": "high",
        "title": "File URI Parsing",
        "description": "Parsing de URIs de archivo puede ser manipulado.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Usa FileProvider en lugar de file:// URIs."
      },
      {
        "id": "AND-PT-007",
        "pattern": "openInputStream.*getIntent\\(\\)",
        "severity": "critical",
        "title": "Intent File Access",
        "description": "Acceso a archivo desde Intent sin validación.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Valida URI del Intent antes de acceder."
      }
    ],
    "ipc": [
      {
        "id": "AND-IPC-001",
        "pattern": "FLAG_MUTABLE",
        "severity": "high",
        "title": "Mutable PendingIntent",
        "description": "Permite escalada de privilegios por terceros.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Usa FLAG_IMMUTABLE."
      },
      {
        "id": "AND-IPC-002",
        "pattern": "sendBroadcast\\(",
        "severity": "medium",
        "title": "Unprotected Broadcast",
        "description": "Emisión de datos sin restricciones.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Usa LocalBroadcastManager."
      },
      {
        "id": "AND-IPC-003",
        "pattern": "Intent\\.parseUri",
        "severity": "high",
        "title": "Intent Scheme Hijacking",
        "description": "Parsear URIs permite ejecución arbitraria.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Valida esquemas estrictamente."
      },
      {
        "id": "AND-IPC-004",
        "pattern": "sendStickyBroadcast",
        "severity": "high",
        "title": "Sticky Broadcast",
        "description": "Deprecado y permite lectura por cualquier app.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Evita su uso."
      },
      {
        "id": "AND-IPC-005",
        "pattern": "registerReceiver\\(",
        "severity": "medium",
        "title": "Dynamic Broadcast Receiver",
        "description": "Registro en runtime sin restricciones.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Restringe emisores permitidos."
      },
      {
        "id": "AND-IPC-006",
        "pattern": "startActivity\\(new\\s+Intent\\(['\"].*['\"]\\)\\)",
        "severity": "medium",
        "title": "Implicit Intent",
        "description": "Vulnerable a interceptación por apps maliciosas.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Usa Intents explícitos."
      },
      {
        "id": "AND-IPC-007",
        "pattern": "getIntent\\(\\)\\.get.*Extra",
        "severity": "medium",
        "title": "Unvalidated Intent Data",
        "description": "Datos de Intent usados sin validación.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Valida todos los extras del Intent."
      }
    ],
    "webview": [
      {
        "id": "AND-WV-001",
        "pattern": "setJavaScriptEnabled\\(true",
        "severity": "medium",
        "title": "JS Enabled",
        "description": "Aumenta la superficie de ataque XSS.",
        "owaspCategory": "M7: Client Code Quality",
        "recommendation": "Desactiva JS si no es vital."
      },
      {
        "id": "AND-WV-002",
        "pattern": "addJavascriptInterface",
        "severity": "critical",
        "title": "WebView Bridge RCE",
        "description": "Expone métodos Java a JS.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Usa @JavascriptInterface y minSdkVersion >= 17."
      },
      {
        "id": "AND-WV-003",
        "pattern": "setAllowFileAccess\\(true",
        "severity": "high",
        "title": "WebView File Access",
        "description": "Permite lectura de archivos locales.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Desactiva acceso local."
      },
      {
        "id": "AND-WV-004",
        "pattern": "handler\\.proceed\\(\\)",
        "severity": "critical",
        "title": "Ignoring SSL Errors",
        "description": "Ignora errores SSL facilitando MITM.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Nunca uses proceed() en producción."
      },
      {
        "id": "AND-WV-005",
        "pattern": "setWebContentsDebuggingEnabled\\(true",
        "severity": "high",
        "title": "WebView Debugging",
        "description": "Permite inspección remota en release.",
        "owaspCategory": "M7: Client Code Quality",
        "recommendation": "Desactiva en builds finales."
      },
      {
        "id": "AND-WV-006",
        "pattern": "MIXED_CONTENT_ALWAYS_ALLOW",
        "severity": "high",
        "title": "Insecure Mixed Content",
        "description": "Carga recursos HTTP en páginas HTTPS.",
        "owaspCategory": "M3: Insecure Communication",
        "recommendation": "Usa NEVER_ALLOW."
      },
      {
        "id": "AND-WV-007",
        "pattern": "loadUrl\\(['\"]javascript:",
        "severity": "high",
        "title": "Inline JS Loading",
        "description": "Ejecución dinámica de JS inyectado.",
        "owaspCategory": "M7: Client Code Quality",
        "recommendation": "Usa evaluateJavascript()."
      },
      {
        "id": "AND-WV-008",
        "pattern": "setAllowUniversalAccessFromFileURLs\\(true",
        "severity": "critical",
        "title": "Universal File Access",
        "description": "Permite acceso universal desde file:// URLs.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Nunca habilites esta opción."
      },
      {
        "id": "AND-WV-009",
        "pattern": "setAllowFileAccessFromFileURLs\\(true",
        "severity": "critical",
        "title": "File URL Cross-Access",
        "description": "Permite que file:// acceda a otros archivos locales.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Deshabilita esta opción."
      },
      {
        "id": "AND-WV-010",
        "pattern": "loadUrl\\(.*?\\+",
        "severity": "high",
        "title": "Dynamic URL Loading",
        "description": "Carga de URL construida dinámicamente puede permitir inyección.",
        "owaspCategory": "M7: Client Code Quality",
        "recommendation": "Valida URLs antes de cargar."
      },
      {
        "id": "AND-WV-011",
        "pattern": "shouldOverrideUrlLoading.*return false",
        "severity": "medium",
        "title": "URL Override Disabled",
        "description": "No se validan las navegaciones del WebView.",
        "owaspCategory": "M1: Improper Platform Usage",
        "recommendation": "Implementa validación de URLs."
      }
    ],
    "logging": [
      {
        "id": "AND-LOG-001",
        "pattern": "Log\\.(v|d|i|w|e)\\(.*?(password|token|key|secret|credential|apikey|api_key)",
