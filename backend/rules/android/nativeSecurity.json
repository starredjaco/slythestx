      {
        "id": "AND-LOG-004",
        "pattern": "System\\.err\\.println",
        "severity": "low",
        "title": "Standard Error Usage",
        "description": "Errores van directos al log del sistema.",
        "owaspCategory": "M7: Client Code Quality",
        "recommendation": "Usa android.util.Log."
      }
    ],
